{
  "name": "Tracker flight radar",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Flight radar",
      "onAutoForward": "openBrowser"
    }
  },
  "postAttachCommand": "npm start",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
